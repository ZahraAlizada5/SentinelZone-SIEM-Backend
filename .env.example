# Production template. For local fixture development explicitly change APP_ENV and ALLOW_FIXTURES.
APP_ENV=production
DEBUG=false
ALLOW_FIXTURES=false
ENABLE_LEGACY_MOCK_ROUTES=false
DEFAULT_TENANT_ID=lab

# Compose uses the service hostname postgres. Native installation: replace with your DB hostname.
# Generate a new random password, set it in BOTH variables, URL-encode it inside DATABASE_URL.
POSTGRES_DB=sentinelzone
POSTGRES_USER=sentinelzone
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://sentinelzone:CHANGE_ME_GENERATE_RANDOM_PASSWORD@postgres:5432/sentinelzone

# Preferred: DB users. After migrate, run: python -m app.cli create-user soc-admin admin
AUTH_DB_ENABLED=true
AUTH_TOKENS=
# Optional bootstrap format: RANDOM_32_PLUS_CHARACTER_TOKEN:username:admin:lab
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
FORWARDED_ALLOW_IPS=127.0.0.1

# Empty URLs are visibly NOT_CONFIGURED. They never enable fixture ingestion in production.
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_CA_FILE=
SPLUNK_INDEX=main
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_CA_FILE=
# This contract requires an alerts adapter; do not assume the standard Manager has /alerts.
WAZUH_ALERTS_PATH=/alerts
CRYPTOGUARD_URL=
CRYPTOGUARD_READ_KEY=
CRYPTOGUARD_CA_FILE=
CRYPTOGUARD_EVENTS_PATH=/v1/telemetry
CONNECTOR_TIMEOUT_SECONDS=10
CONNECTOR_RETRIES=2
INGEST_INTERVAL_SECONDS=30
INGEST_OVERLAP_SECONDS=120
MAX_INGEST_EVENTS=10000
STALE_AFTER_MINUTES=15
CORRELATION_WINDOW_MINUTES=15

# Set only after a heartbeat/telemetry feed and its cadence are verified.
# Example syntax: {"suricata":60,"cowrie":60,"windows":60,"wazuh":60,"cryptoguard":60}
SENSOR_EXPECTED_INTERVALS={}
SENSOR_OFFLINE_MULTIPLIER=3

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEGACY_TELEGRAM_ACTIVE=false
TELEGRAM_CANARY_ENABLED=false
TELEGRAM_CANARY_HOSTS=
SMS_ENABLED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_TO=
DISPATCH_INTERVAL_SECONDS=5
NOTIFY_MAX_ATTEMPTS=5
NOTIFICATION_TEMPLATE_VERSION=1
# Empty means DEFAULT_TENANT_ID. External destinations are never shared across all tenants.
NOTIFICATION_TENANT_ID=
ALLOW_TEST_NOTIFICATIONS=false
TEST_TELEGRAM_CHAT_ID=
PROTECTED_TARGETS=
PROTECTED_ASSET_ROLES=splunk,wazuh-manager,pfsense,domain-controller,backup,admin-host
